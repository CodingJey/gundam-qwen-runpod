# ---------------------------------------------------------------------------
# Runpod account
# ---------------------------------------------------------------------------
# Create at https://console.runpod.io/user/credentials
RUNPOD_API_KEY=

# Image built by .github/workflows/build.yml. Use the :latest tag while
# iterating, or pin a :sha-xxxxxxx tag for reproducibility.
RUNPOD_IMAGE=ghcr.io/your-github-user/gundam-qwen:latest

# Optional: Runpod "Container Registry Auth" credential ID for a PRIVATE GHCR
# package. Leave blank if the GHCR package is public.
RUNPOD_REGISTRY_AUTH_ID=

# RTX 3090 Community Cloud is usually $0.22/hr; Secure Cloud is $0.50/hr.
RUNPOD_GPU=NVIDIA GeForce RTX 3090
RUNPOD_CLOUD=COMMUNITY

# Optional placement controls. Leave blank to let the launcher pick a data
# center that currently reports 3090 stock.
# RUNPOD_REGION=NORTH_AMERICA
# RUNPOD_DATA_CENTER_ID=US-KS-2

# Optional: attach an existing network volume instead of a pod volume disk.
# The volume must be in the same data center as the pod.
# RUNPOD_NETWORK_VOLUME_ID=

# Storage. The volume disk survives stop/restart and is deleted on terminate.
RUNPOD_CONTAINER_DISK_GB=40
RUNPOD_VOLUME_GB=50

RUNPOD_POD_NAME=gundam-qwen
RUNPOD_HTTP_PORT=8188

# ---------------------------------------------------------------------------
# UI authentication (required)
# ---------------------------------------------------------------------------
BASIC_AUTH_USER=gundam
# Change this. Use: openssl rand -hex 24
BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# ---------------------------------------------------------------------------
# Gundam LoRA (optional but recommended)
# ---------------------------------------------------------------------------
# A direct .safetensors URL. The container downloads it on first boot as
# GUNDAM_LORA_FILENAME. For Civitai, also set CIVITAI_TOKEN.
#
# Example (generic mecha LoRA, not Gundam-specific):
# GUNDAM_LORA_URL=https://civitai.com/api/download/models/2230612
# GUNDAM_LORA_FILENAME=gundam_qwen_image.safetensors
GUNDAM_LORA_URL=
GUNDAM_LORA_FILENAME=gundam_qwen_image.safetensors
# Filename used by scripts/generate.py; keep it in sync with GUNDAM_LORA_FILENAME.
# GUNDAM_LORA_NAME=gundam_qwen_image.safetensors

# Create at https://civitai.com/user/account (API Keys)
CIVITAI_TOKEN=

# Optional for gated Hugging Face repos.
HF_TOKEN=

# Optional: use the pod's ComfyUI API without reading .runpod-state.json.
# COMFYUI_URL=https://<pod-id>-8188.proxy.runpod.net
# COMFYUI_USER=gundam
# COMFYUI_PASSWORD=

# Set to 1 if ComfyUI is killed for RAM/VRAM pressure (slower, less caching).
COMFYUI_CACHE_NONE=0
